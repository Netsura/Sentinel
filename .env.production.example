# Production secrets for docker compose -f docker-compose.prod.yml
# Copy to .env.production and replace every replace-me value.
#   cp .env.production.example .env.production

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-me-with-a-strong-database-password
POSTGRES_DB=sentinel
DATABASE_URL=postgresql://sentinel:replace-me-with-a-strong-database-password@postgres:5432/sentinel?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-second-long-random-value

# Public origin the browser uses (no trailing slash). HTTP is fine for a first local prod run.
WEB_ORIGIN=http://localhost
NEXT_PUBLIC_API_URL=/api

ADMIN_EMAILS=
SMTP_URL=
MAIL_FROM=Sentinel <noreply@localhost>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
